# ──────────────────────────────────────────────
# Stage 1: Build Vue frontend
# ──────────────────────────────────────────────
FROM node:20-slim AS frontend-builder

WORKDIR /build
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm install --registry https://registry.npmmirror.com
COPY frontend/ ./
RUN npx vite build --outDir /static --emptyOutDir

# ──────────────────────────────────────────────
# Stage 2: Reuse grok-register-base (Chrome + Xvfb + Python already included)
# ──────────────────────────────────────────────
FROM grok-register-base:latest

WORKDIR /app

# Install web-only deps (flask) alongside existing registration deps
COPY requirements.txt /app/requirements.txt
COPY web/requirements.txt /app/web-requirements.txt
RUN pip3 install --break-system-packages --no-cache-dir \
    -r /app/requirements.txt -r /app/web-requirements.txt

# Copy application code
COPY . /app

# Copy built frontend
COPY --from=frontend-builder /static /app/web/static

ENV GROK_DOCKER=1
ENV GROK_AUTO_START=1
ENV PYTHONUNBUFFERED=1

COPY web/entrypoint-web.sh /entrypoint-web.sh
RUN chmod +x /entrypoint-web.sh

EXPOSE 8080
ENTRYPOINT ["/entrypoint-web.sh"]
