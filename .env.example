# ──────────────────────────────────────────────
# grok-stack 环境变量配置
#
# 使用方法：
#   1. 复制此文件为 .env
#   2. 填入你的订阅链接
#   3. docker compose up -d
#
# .env 文件已在 .gitignore 中，不会被提交
# ──────────────────────────────────────────────

# mihomo 代理订阅链接（必填）
SUB_URL=https://your-subscription-url.example.com/clashx/xxxxx
