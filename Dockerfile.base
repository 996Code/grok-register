FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# 系统依赖：Xvfb、Python3、字体、Chrome 运行库
RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb \
    wget \
    gnupg \
    python3 \
    python3-pip \
    python3-venv \
    fonts-wqy-zenhei \
    fonts-wqy-microhei \
    fonts-liberation \
    fonts-noto-cjk \
    libnss3 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxcomposite1 \
    libxrandr2 \
    libxdamage1 \
    libgbm1 \
    libasound2t64 \
    libpango-1.0-0 \
    libcairo2 \
    libgtk-3-0 \
    libxss1 \
    libxtst6 \
    libappindicator3-1 \
    xdg-utils \
    curl \
    iproute2 \
    procps \
    && rm -rf /var/lib/apt/lists/*

# 安装 Google Chrome（真正的二进制，非 snap wrapper）
RUN wget -q -O /tmp/chrome.deb https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb \
    && apt-get update \
    && apt-get install -y --no-install-recommends /tmp/chrome.deb \
    && rm -f /tmp/chrome.deb \
    && rm -rf /var/lib/apt/lists/*

# 验证
RUN which google-chrome-stable && google-chrome-stable --version

# 预装 DrissionPage 常用依赖（减少应用层构建时间）
RUN pip3 install --break-system-packages --no-cache-dir \
    "DrissionPage>=4.1.1.2,<4.2" \
    curl_cffi==0.13.0 \
    filelock==3.19.1 \
    requests==2.32.5 \
    psutil==7.2.2

# 环境变量
ENV DISPLAY=:99
ENV PYTHONUNBUFFERED=1
